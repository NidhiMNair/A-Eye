# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Synthetic test data & results output (do not commit large binaries)
fixtures/synthetic/
results/
*.avi
*.mp4
*.png
*.jpg

# Raw & split dataset contents (do not commit dataset files/recordings)
data/*
!data/README.md
!data/.gitkeep
